# Network facts come from src/appConfig/{prerelease,production}.json.
REACT_APP_CONFIG_ENV=prerelease

# Required public service endpoints. Supply services for the selected network.
REACT_APP_API_INFLUENCE=
REACT_APP_API_IPFS=
REACT_APP_API_AVNU=
REACT_APP_STARKNET_PROVIDER=
REACT_APP_ETHEREUM_PROVIDER=

# Optional public integrations. Empty values disable their UI.
REACT_APP_PRIVY_APPID=
REACT_APP_PRIVY_CLIENTID=
# Required when Privy is enabled; this is the authenticated server proxy URL.
REACT_APP_STARKNET_PAYMASTERPROXY=
REACT_APP_API_CLIENTID_STRIPE=
REACT_APP_API_BANXA=
REACT_APP_API_CLIENTID_LAYERSWAP=
REACT_APP_API_CLIENTID_GOOGLE=
REACT_APP_API_CLIENTID_GTM=

# Optional RPC redundancy and external-wallet paymaster service.
REACT_APP_STARKNET_PROVIDERBACKUP=
REACT_APP_STARKNET_PAYMASTER=
# REACT_APP_BANXA_MINFIAT=11

# Optional browser behavior (true/false or 1/0).
# REACT_APP_APP_ENABLEDEVTOOLS=false
# REACT_APP_APP_VERBOSELOGS=false
# REACT_APP_APP_DISABLEINTROANIMATION=true
# REACT_APP_APP_DISABLELAUNCHERLANDING=true
# REACT_APP_APP_DISABLELAUNCHTRAILER=true
# REACT_APP_APP_DISABLESCREENSIZEWARNING=true
# REACT_APP_APP_DEFAULTMUTED=true

# Server-only settings; never exposed in runtime-config.js.
# PORT=3000
# AUTH_PASSWORD=
